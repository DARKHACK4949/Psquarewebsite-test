# Public site URL (canonical, sitemap, OG). Set per environment on Vercel.
NEXT_PUBLIC_SITE_URL=https://ca.psquarecompany.com

# Contact form delivery: set at least one in production (the API returns 503 otherwise).
RESEND_API_KEY=
CONTACT_TO=info@psquarecompany.com
CONTACT_FROM="PSQUARE COMPANY <website@psquarecompany.com>"
# Optional CRM / automation webhook (receives the JSON payload).
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# Brief uploads: S3 or Cloudflare R2 (set UPLOAD_ENDPOINT for R2).
UPLOAD_BUCKET=
UPLOAD_REGION=auto
UPLOAD_ENDPOINT=
UPLOAD_ACCESS_KEY_ID=
UPLOAD_SECRET_ACCESS_KEY=
UPLOAD_PUBLIC_BASE_URL=
